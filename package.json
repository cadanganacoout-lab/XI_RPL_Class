{
  "name": "new---class",
  "version": "1.0.0",
  "description": "<!-- NAMA SISWA -->",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/dev-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "npm audit --omit=dev",
    "lint": "eslint api scripts tests",
    "db:indexes": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/create-indexes.js",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/migrate-legacy.js",
    "db:user:create-admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/create-admin.js",
    "db:user:create-student": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/create-student.js",
    "db:user:reset-password": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/reset-password.js",
    "db:user:set-active": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=atlas-credentials.env scripts/set-active.js",
    "check:api": "node --test tests/api.test.js tests/mongo.test.js tests/admin-users.test.js tests/cards.test.js tests/profiles.test.js",
    "check:runtime": "node scripts/runtime-check.js",
    "check:browser": "node scripts/puppeteer-check.js",
    "check": "npm run lint && npm run check:api && npm run check:runtime && npm run check:browser"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadanganacoout-lab/new---class.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cadanganacoout-lab/new---class/issues"
  },
  "homepage": "https://github.com/cadanganacoout-lab/new---class#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^21.1.2",
    "puppeteer": "^25.16.0",
    "vite": "^7.0.0"
  }
}
